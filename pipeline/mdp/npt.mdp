define                  = -DPOSRES
integrator              = md
nsteps                  = 250000    ; 500 ps
dt                      = 0.002
nstlist                 = 20
cutoff-scheme           = Verlet
ns_type                 = grid
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau_t                   = 0.1     0.1
ref_t                   = 310     310
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5
refcoord_scaling        = com       ; THE FIX: Scales restraints with the box
constraints             = h-bonds
continuation            = yes
